          "distance": 2.7
        },
        "duration": 2.3
      },
      {
        "id": "sc04_arrive_03",
        "speaker": "TAVO",
        "text": "You knew this could happen?",
        "shot": {
          "target": "Player",
          "height": 1.4,
          "distance": 2.7
        },
        "duration": 1.6
      },
      {
        "id": "sc04_arrive_04",
        "speaker": "MERA",
        "text": "I hoped it wouldn't.",
        "duration": 1.5
      },
      {
        "id": "sc04_arrive_08",
        "speaker": "MERA",
        "text": "Ask Eren where he put the transfer slips. Bring them back.",
        "shot": {
          "target": "Mera",
          "height": 1.4,
          "distance": 2.8
        },
        "duration": 3
      },
      {
        "id": "sc04_arrive_09",
        "speaker": "SENA",
        "text": "And the wheel. We still need water.",
        "duration": 1.8
      }
    ],
    "gift": [
      {
        "id": "sc04_gift_01",
        "speaker": "",
        "text": "",
        "delivery": "cinematic",
        "stage": "gift",
