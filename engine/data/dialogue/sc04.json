      },
      {
        "id": "sc04_gift_02",
        "speaker": "SENA",
        "text": "The key fits. Probably. And take the bird.",
        "duration": 2.2
      }
    ],
    "seven": [
      {
        "id": "sc04_seven_01",
        "speaker": "MERA",
        "text": "Tavo. When you were seven... you weren't just sick.",
        "delivery": "cinematic",
        "shot": {
          "target": "Mera",
          "height": 1.4,
          "distance": 2.5
        },
        "duration": 2.7
      },
      {
        "id": "sc04_seven_02",
        "speaker": "TAVO",
        "text": "Then what was I?",
        "duration": 1.3
      },
      {
        "id": "sc04_seven_03",
        "speaker": "MERA",
        "text": "There's something I need to find. Come back. I'll show you.",
        "duration": 2.7
      }
    ],
    "gate": [
      {
        "id": "sc04_gate_02",
        "speaker": "DARU",
        "text": "If you're late, I'll come fetch you.",
        "delivery": "ambient"
