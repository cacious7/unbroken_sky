extends SceneTree
## Writes the cast's sprites to assets/art/characters/ as SVG, all from one template so
## every character shares Tavo's proportions and style. Original designs; clothing uses
## plain colours and simple trim, not real community textiles or ceremonial dress.
## Run from the engine folder:
##   godot --headless --path . --script res://tools/generate_characters.gd

const OUT := "res://assets/art/characters/"

## skin, hair style + colour, top, accent (sash/trim), lower style + colour, extras.
const CAST := {
	"tavo": {"skin": "#6b4126", "hair": "short", "hair_color": "#1a110b", "top": "#2f4f7a",
		"accent": "#d49a3a", "lower": "trousers", "bottom": "#4a3424", "extras": ["satchel", "hammer", "wrist_cuts"]},
	"sena": {"skin": "#7a4a2c", "hair": "braids", "hair_color": "#1a110b", "top": "#b5562f",
		"accent": "#3d2b1f", "lower": "trousers", "bottom": "#3d3a35", "extras": ["apron", "tongs"]},
	"mera": {"skin": "#5e3a24", "hair": "wrap", "hair_color": "#6b4f7a", "top": "#4e5b3c",
		"accent": "#c9a24a", "lower": "wrap", "bottom": "#6b4f7a", "extras": ["scarf"]},
	"figure": {"skin": "#4a3a34", "hair": "wrap", "hair_color": "#3e3550", "top": "#323b30",
		"accent": "#7d6a3a", "lower": "wrap", "bottom": "#3e3550", "extras": ["scarf", "wet"]},
	"daru": {"skin": "#4f2f1c", "hair": "short", "hair_color": "#120c08", "top": "#6b6a3a",
		"accent": "#8a2f2f", "lower": "trousers", "bottom": "#3b3a2c", "extras": ["spear", "armband"]},
	"nali": {"skin": "#6e452a", "hair": "bun", "hair_color": "#120c08", "top": "#e8e2d0",
		"accent": "#3f7f8a", "lower": "wrap", "bottom": "#3f7f8a", "extras": ["medbag"]},
	"veya": {"skin": "#5a3720", "hair": "short", "hair_color": "#120c08", "top": "#2e3b4a",
		"accent": "#c08a3e", "lower": "trousers", "bottom": "#2a2a2a", "extras": ["spanner", "goggles"]},
	"kesi": {"skin": "#4a2c1a", "hair": "hood", "hair_color": "#8a7a5a", "top": "#5a4e3a",
		"accent": "#2e2a22", "lower": "trousers", "bottom": "#3a332a", "extras": ["shawl"]},
	"orun": {"skin": "#5b3a24", "hair": "short", "hair_color": "#9a948a", "top": "#e3d6b8",
		"accent": "#7a5a2a", "lower": "robe", "bottom": "#e3d6b8", "extras": ["beard"]},
	"lio": {"skin": "#6a4329", "hair": "short", "hair_color": "#1a110b", "top": "#9fb07a",
		"accent": "#e3d6b8", "lower": "trousers", "bottom": "#4a4a3a", "extras": ["waterskin"]},
	"merchant": {"skin": "#5e3b25", "hair": "bald", "hair_color": "#2a1d14", "top": "#a0703a",
		"accent": "#e0c060", "lower": "trousers", "bottom": "#5a4632", "extras": ["beard", "satchel"]},
}


func _init() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT))
	for character_name: String in CAST:
		var file := FileAccess.open(ProjectSettings.globalize_path(OUT + character_name + ".svg"), FileAccess.WRITE)
		file.store_string(_svg(character_name, CAST[character_name]))
		print("wrote ", character_name)
	quit()


func _svg(character_name: String, c: Dictionary) -> String:
	var extras: Array = c.extras
	var skin: String = c.skin
	var parts: Array[String] = []
	parts.append('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 96" width="64" height="96">')
	parts.append('<!-- %s: generated by tools/generate_characters.gd -->' % character_name)
	if not extras.has("wet"):
		parts.append('<ellipse cx="32" cy="90" rx="17" ry="4.5" fill="#000" opacity="0.25"/>')

	# Behind the body.
	if extras.has("spear"):
		parts.append('<rect x="52" y="4" width="3" height="84" rx="1.5" fill="#7a5a3a"/>')
		parts.append('<path d="M53.5 0 L57 9 L50 9 Z" fill="#9aa2a8"/>')
	if extras.has("satchel"):
		parts.append('<path d="M19 36 L45 62" stroke="#7a4b22" stroke-width="4" stroke-linecap="round"/>')

	# Legs, wrap or robe.
	match c.lower:
		"trousers":
			parts.append('<rect x="22" y="62" width="8" height="24" rx="3" fill="%s"/>' % c.bottom)
			parts.append('<rect x="34" y="62" width="8" height="24" rx="3" fill="%s"/>' % c.bottom)
			parts.append('<rect x="20" y="84" width="11" height="5" rx="2" fill="#2b1d13"/>')
			parts.append('<rect x="33" y="84" width="11" height="5" rx="2" fill="#2b1d13"/>')
		"wrap":
			parts.append('<path d="M17 56 L47 56 L50 86 Q32 90 14 86 Z" fill="%s"/>' % c.bottom)
			parts.append('<path d="M15.5 80 Q32 84 48.5 80" stroke="%s" stroke-width="2.5" fill="none"/>' % c.accent)
			parts.append('<rect x="22" y="85" width="9" height="4" rx="2" fill="#2b1d13"/>')
			parts.append('<rect x="33" y="85" width="9" height="4" rx="2" fill="#2b1d13"/>')
		"robe":
			parts.append('<path d="M17 40 L47 40 L51 88 Q32 92 13 88 Z" fill="%s"/>' % c.bottom)
			parts.append('<path d="M32 40 L32 88" stroke="%s" stroke-width="3"/>' % c.accent)
			parts.append('<path d="M14 84 Q32 88 50 84" stroke="%s" stroke-width="3" fill="none"/>' % c.accent)

	# Torso.
	parts.append('<path d="M18 36 Q32 30 46 36 L48 66 Q32 70 16 66 Z" fill="%s"/>' % c.top)
	if c.lower != "robe":
		parts.append('<path d="M18 52 L46 52 L46 57 L18 57 Z" fill="%s"/>' % c.accent)
	parts.append('<path d="M26 36 L32 45 L38 36" fill="none" stroke="#000" stroke-opacity="0.25" stroke-width="2"/>')
	if extras.has("apron"):
		parts.append('<path d="M22 40 L42 40 L44 68 L20 68 Z" fill="%s"/>' % c.accent)
		parts.append('<rect x="27" y="56" width="10" height="7" rx="1" fill="#000" opacity="0.2"/>')
	if extras.has("armband"):
		parts.append('<rect x="10" y="42" width="8" height="4" fill="%s"/>' % c.accent)
	if extras.has("shawl"):
		parts.append('<path d="M14 34 Q32 26 50 34 L48 50 Q32 44 16 50 Z" fill="%s"/>' % c.hair_color)
		for spot: Array in [[20, 38], [27, 43], [37, 37], [44, 42], [31, 34]]:
			parts.append('<circle cx="%d" cy="%d" r="2" fill="#3a3024"/>' % spot)
	if extras.has("scarf"):
		parts.append('<path d="M20 32 Q32 40 44 32 L44 37 Q32 45 20 37 Z" fill="#c96f3b"/>')
		parts.append('<path d="M40 36 L44 54 L38 54 Z" fill="#c96f3b"/>')

	# Arms (bare forearms in skin tone).
	parts.append('<rect x="10" y="38" width="8" height="22" rx="4" fill="%s"/>' % skin)
	parts.append('<rect x="46" y="38" width="8" height="22" rx="4" fill="%s"/>' % skin)
	parts.append('<rect x="10" y="38" width="8" height="8" rx="3" fill="%s"/>' % c.top)
	parts.append('<rect x="46" y="38" width="8" height="8" rx="3" fill="%s"/>' % c.top)

	# Held items and bags (in front).
	if extras.has("satchel"):
		parts.append('<rect x="38" y="56" width="16" height="13" rx="3" fill="#9a6230" stroke="#6b411c" stroke-width="1.5"/>')
	if extras.has("hammer"):
		parts.append('<rect x="51" y="46" width="3.5" height="18" rx="1.5" fill="#8a6a44"/>')
		parts.append('<rect x="47" y="44" width="12" height="6" rx="1.5" fill="#9aa2a8" stroke="#5f666b" stroke-width="1"/>')
	if extras.has("tongs"):
		parts.append('<path d="M52 50 L56 72 M55 50 L58 72" stroke="#5f666b" stroke-width="2"/>')
	if extras.has("spanner"):
		parts.append('<rect x="51" y="48" width="3.5" height="16" fill="#8a9096"/>')
		parts.append('<path d="M48 46 Q52.5 40 57 46 L55 48 L50 48 Z" fill="#8a9096"/>')
	if extras.has("medbag"):
		parts.append('<path d="M19 36 L45 62" stroke="#5a4a3a" stroke-width="3" stroke-linecap="round"/>')
		parts.append('<rect x="38" y="56" width="16" height="13" rx="3" fill="#e8e2d0" stroke="#7a6a5a" stroke-width="1.5"/>')
		# A leaf, not a red cross (the red cross emblem is legally protected).
		parts.append('<path d="M46 59 Q51 62 46 67 Q41 62 46 59 Z" fill="#4f8a4a"/>')
	if extras.has("waterskin"):
		parts.append('<ellipse cx="14" cy="64" rx="5" ry="7" fill="#8a6a44" stroke="#5a4229" stroke-width="1"/>')

	# Neck and head.
	parts.append('<rect x="28" y="28" width="8" height="8" fill="%s"/>' % skin)
	parts.append('<circle cx="32" cy="19" r="13" fill="%s"/>' % skin)
	parts.append(_hair(c.hair, c.hair_color))
	if extras.has("goggles"):
		parts.append('<rect x="20" y="9" width="24" height="5" rx="2" fill="#5a4a3a"/>')
		parts.append('<circle cx="26" cy="11.5" r="3.5" fill="#c08a3e" stroke="#5a4a3a"/>')
		parts.append('<circle cx="38" cy="11.5" r="3.5" fill="#c08a3e" stroke="#5a4a3a"/>')

	# Face.
	var eye := "#1a110b" if not extras.has("wet") else "#0a0d12"
	parts.append('<ellipse cx="27" cy="20" rx="1.8" ry="2.2" fill="%s"/>' % eye)
	parts.append('<ellipse cx="37" cy="20" rx="1.8" ry="2.2" fill="%s"/>' % eye)
	if extras.has("wet"):
		parts.append('<path d="M28 27 L36 27" stroke="#0a0d12" stroke-width="1.5"/>')
	else:
		parts.append('<path d="M28 26 Q32 28.5 36 26" fill="none" stroke="#000" stroke-opacity="0.45" stroke-width="1.5" stroke-linecap="round"/>')
	if extras.has("beard"):
		parts.append('<path d="M21 22 Q22 33 32 34 Q42 33 43 22 Q40 29 32 29 Q24 29 21 22 Z" fill="%s"/>' % c.hair_color)
	if extras.has("wrist_cuts"):
		parts.append('<path d="M11 55 L17 54 M11 57.5 L17 56.5 M11 60 L17 59" stroke="#3a2214" stroke-width="0.9"/>')

	# The counterfeit mother is wet in a dry culvert: drips and a dark sheen.
	if extras.has("wet"):
		for drip: Array in [[16, 70], [22, 86], [44, 76], [49, 88], [12, 52], [52, 56]]:
			parts.append('<path d="M%d %d q2 4 0 6 q-2 -2 0 -6 Z" fill="#6fa3c8"/>' % drip)
		parts.append('<ellipse cx="32" cy="91" rx="20" ry="4" fill="#2c4a63" opacity="0.7"/>')

	parts.append('</svg>')
	return "\n".join(parts) + "\n"


func _hair(style: String, color: String) -> String:
	match style:
		"short":
			return '<path d="M19 17 Q20 5 32 5 Q44 5 45 17 Q40 11 32 11 Q24 11 19 17 Z" fill="%s"/>' % color
		"braids":
			var strands := ""
			for x: int in [20, 23, 41, 44]:
				strands += '<path d="M%d 14 L%d 34" stroke="%s" stroke-width="3" stroke-linecap="round"/>' % [x, x - 1 if x < 32 else x + 1, color]
			return '<path d="M18 17 Q19 4 32 4 Q45 4 46 17 Q40 9 32 9 Q24 9 18 17 Z" fill="%s"/>' % color + strands
		"bun":
			return '<path d="M19 17 Q20 5 32 5 Q44 5 45 17 Q40 11 32 11 Q24 11 19 17 Z" fill="%s"/>' % color \
					+ '<circle cx="32" cy="3.5" r="5.5" fill="%s"/>' % color
		"wrap":
			return '<path d="M17 18 Q15 0 32 0 Q49 0 47 18 Q41 9 32 9 Q23 9 17 18 Z" fill="%s"/>' % color \
					+ '<circle cx="42" cy="4" r="4" fill="%s"/>' % color
		"hood":
			return '<path d="M16 26 Q14 2 32 2 Q50 2 48 26 Q46 12 32 11 Q18 12 16 26 Z" fill="%s"/>' % color
		"bald":
			return '<path d="M24 9 Q32 5 40 9" stroke="#fff" stroke-opacity="0.2" stroke-width="2" fill="none"/>'
	return ""
